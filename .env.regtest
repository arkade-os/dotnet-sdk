# dotnet-sdk arkade-regtest overrides

# nbxplorer guard in start-env.sh handles missing container gracefully
BITCOIN_LOW_FEE=true

# ── arkd override ──────────────────────────────────────────────────────────
# A deprecated signer is pre-configured so the rotation E2E (ServerKeyRotationSweeperTests
# and the digest-mismatch transport path) RUNS instead of Assert.Ignore-ing: the wallet's current
# signer is S2, with S1 declared deprecated at a far-future cutoff (1900000000 ≈ year 2030). The
# far-future cutoff keeps S1 inside its collaborative-sweep window, so arkd still co-signs S1 spends
# (regime 1) and the sweeper can migrate an S1 VTXO onto the current S2 signer.
# ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.12-rc.0
# ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.12-rc.0
ARKD_WALLET_SIGNER_KEY=9f80812085352f57a5e8104d6406b4d3b191cfdeb96e1321d6284d8d9bb6e8a1
ARKD_WALLET_DEPRECATED_SIGNER_KEYS=cca401847e4d3635339747f84b7353160acb51951ad287a19f8148835372f1ef:1900000000


# ── intent-solver ──────────────────────────────────────────────────────────
# regtest/.env.defaults leaves this EMPTY, which switches the profile off, and the
# orchestrator skips it silently rather than failing. Naming an image here is what turns the
# Lightning and onchain corridors on — for CI and for a local run alike, since regtest reads
# this file as its override (regtest/lib/env.mjs), so there is one place to bump.
#
# The tag carries no `v`: `0.2.0` is what is published to ghcr, `v0.2.0` is a repo tag with no
# image behind it. Public, so no login. amd64-only — an arm64 machine needs
# DOCKER_DEFAULT_PLATFORM=linux/amd64 and emulation.
INTENT_SOLVER_IMAGE=ghcr.io/arkade-os/intent-solver:0.2.0

# ── covclaimd ──────────────────────────────────────────────────────────────
# Same idiom, same reason: regtest names no default for this either, so the profile is skipped
# silently unless an image is given — and `intent-solver`'s dependency closure does NOT pull it
# in. The onchain suites read their claim key off :7271 before they negotiate, so without this
# every one of them dies on a refused connection rather than on anything about a corridor.
#
# rc.4, not the compose fallback rc.1: the corridors build VHTLC **v2**, whose preimage leaf
# carries `OP_SIZE 32 OP_EQUALVERIFY` ahead of the hash check, and rc.3 is where covclaimd's
# `findClaimClosure` started matching that shape byte for byte.
COVCLAIMD_IMAGE=ghcr.io/arkade-os/covclaimd:v0.0.1-rc.4
