<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CliWrap" Version="3.10.0" />
        <PackageReference Include="coverlet.collector" Version="6.0.4" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.16" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
        <PackageReference Include="NUnit" Version="4.4.0" />
        <PackageReference Include="NUnit.Analyzers" Version="4.11.2">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit3TestAdapter" Version="6.0.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Net" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="NUnit.Framework" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="NUnit.Framework.NonParallelizableAttribute" />
    </ItemGroup>

    <ItemGroup>
      <!-- Test-fixture contract bindings (TestERC20, MockERC20Dex). Generated alongside the
           production bindings in NArk.Swaps.Evm/Contracts/Generated/, but excluded from that
           project's compile items so they don't ship in the package — only the E2E suite
           deploys these fixtures. Namespaces stay NArk.Swaps.Evm.Contracts.Test /
           .Contracts.TestFixtures, so no using changes in the test files. -->
      <Compile Include="..\NArk.Swaps.Evm\Contracts\Generated\Test\**\*.cs"
               LinkBase="Evm\Contracts\Test" />
      <Compile Include="..\NArk.Swaps.Evm\Contracts\Generated\TestFixtures\**\*.cs"
               LinkBase="Evm\Contracts\TestFixtures" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\NArk.Abstractions\NArk.Abstractions.csproj" />
      <ProjectReference Include="..\NArk.Core\NArk.Core.csproj" />
      <ProjectReference Include="..\NArk.Storage.EfCore\NArk.Storage.EfCore.csproj" />
      <ProjectReference Include="..\NArk.Swaps\NArk.Swaps.csproj" />
      <ProjectReference Include="..\NArk.Swaps.Evm\NArk.Swaps.Evm.csproj" />
      <ProjectReference Include="..\NArk.Tests\NArk.Tests.csproj" />
    </ItemGroup>

</Project>
