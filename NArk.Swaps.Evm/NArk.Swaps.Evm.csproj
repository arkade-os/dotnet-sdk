<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <PackageDescription>Nethereum-based EVM (Arbitrum) chain-swap leg for Boltz Chain Swaps. Enables Ark-to-EVM and EVM-to-Ark trustless swaps via Boltz's ERC20Swap/EtherSwap contracts.</PackageDescription>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\NArk.Core\NArk.Core.csproj" />
      <ProjectReference Include="..\NArk.Swaps\NArk.Swaps.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Nethereum.Web3" Version="6.1.0" />
      <PackageReference Include="Nethereum.Contracts" Version="6.1.0" />
    </ItemGroup>

    <ItemGroup>
      <!-- tools/AbiGen.cs is a standalone .NET 10 file-based app (dotnet run tools/AbiGen.cs),
           not part of this project's build. -->
      <Compile Remove="tools/**" />
    </ItemGroup>

</Project>
