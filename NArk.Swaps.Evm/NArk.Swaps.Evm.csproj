<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <PackageDescription>Nethereum-based EVM (Arbitrum) chain-swap leg for Boltz Chain Swaps. Enables Ark-to-EVM and EVM-to-Ark trustless swaps via Boltz's ERC20Swap/EtherSwap contracts.</PackageDescription>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\NArk.Core\NArk.Core.csproj" />
      <ProjectReference Include="..\NArk.Swaps\NArk.Swaps.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Nethereum.Web3" Version="6.1.0" />
      <PackageReference Include="Nethereum.Contracts" Version="6.1.0" />
    </ItemGroup>

    <ItemGroup>
      <!-- tools/AbiGen.cs is a standalone .NET 10 file-based app (dotnet run tools/AbiGen.cs),
           not part of this project's build. -->
      <Compile Remove="tools/**" />

      <!-- Bindings for throwaway fixtures (Test/** = TestERC20, TestFixtures/** = MockERC20Dex)
           that only ever get deployed by the E2E suite against a local Anvil chain — nothing in
           the production provider calls them. They stay here so the AbiGen/generate-bindings.sh
           pipeline keeps emitting all bindings to one place, but are compiled into
           NArk.Tests.End2End instead of shipping in this package (see that project's
           <Compile Include> for the same globs). -->
      <Compile Remove="Contracts/Generated/Test/**" />
      <Compile Remove="Contracts/Generated/TestFixtures/**" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>NArk.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>NArk.Tests.End2End</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
